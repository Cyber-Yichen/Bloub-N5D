{
  "name": "bloub-n5d",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Offline Android desk companion for N5D: morphing Bloub, measured cutout and physical light-ring choreography.",
  "license": "MIT",
  "author": "Jérémy Perret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyber-Yichen/Bloub-N5D.git"
  },
  "keywords": [
    "svg",
    "animation",
    "avatar",
    "vue",
    "morphing"
  ],
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:n5d": "vite --config vite.n5d.config.ts --open /n5d.html",
    "build:n5d": "vue-tsc --noEmit && vite build --config vite.n5d.config.ts",
    "build:apk": "bash android/build.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mediabunny": "^1.54.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "contributors": [
    "Cyber-Yichen (N5D adaptation)"
  ]
}
